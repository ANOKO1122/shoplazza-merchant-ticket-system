# 复制为 chatwoot-docker 目录下的 .env.mabang-bridge 并填入实际值

# Chatwoot（与马帮改店匠前相同；API 建议内网直连避免 Nginx 丢头：http://chatwoot:3000）
CHATWOOT_BASE_URL=http://chatwoot:3000
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_API_ACCESS_TOKEN=你的_API_Access_Token

# —— 店匠 Shoplazza（二选一配置方式）——
# 方式 A：多店铺 JSON 数组（推荐）。每店：subdomain（子域名）、accessToken、可选 label（展示名）
# SHOPLAZZA_STORES_JSON=[{"subdomain":"store-a","accessToken":"token-a","label":"旗舰店"},{"subdomain":"store-b","accessToken":"token-b"}]
#
# 方式 B：单店铺（subdomain 仅填子域名，如 crispiner；不要填 crispiner.myshoplaza.com，程序会自动剥后缀）
# SHOPLAZZA_SUBDOMAIN=crispiner
# SHOPLAZZA_ACCESS_TOKEN=该店_Access_Token

# API 版本路径，默认 2025-06（见 https://www.shoplazza.dev/reference/order-list-v2025-06 ）
# SHOPLAZZA_API_VERSION=2025-06

# 订单按创建时间回溯天数（默认 30）
# SHOPLAZZA_DAYS_BACK=30

# 单店分页：每页条数、最多翻页数（防止单店订单量过大拖慢 Webhook）
# SHOPLAZZA_PAGE_LIMIT=50
# SHOPLAZZA_MAX_PAGES_PER_STORE=20

# 桥接端口（默认 4000）
# PORT=4000

# 联系人自定义属性键：订单邮箱/订单号（默认 shoplazza_order_lookup，与 Chatwoot 定义一致需同步修改）
# SHOPLAZZA_ORDER_LOOKUP_ATTRIBUTE_KEY=shoplazza_order_lookup

# —— 店铺持久化与管理 API（推荐生产开启）——
# SQLite 数据目录（compose 已挂载 volume 到 /data）
# BRIDGE_DATA_DIR=/data
# 管理员 Bearer 令牌（随机长串）；未设置时 /admin/* 返回 503，无法增删店铺
# BRIDGE_ADMIN_TOKEN=
# 会话打开主动同步专用令牌（可选；未设置则回退使用 BRIDGE_ADMIN_TOKEN）
# BRIDGE_SYNC_TOKEN=
# 同一联系人主动同步去重窗口（毫秒，默认 8000）
# BRIDGE_ACTIVE_SYNC_DEDUP_MS=8000
# 网页 /admin/ui 登录专用密码（可选）。若设置：须 10–16 位且含字母+数字，否则拒绝启动
# BRIDGE_ADMIN_PASSWORD=Abcd123456
# 会话 Cookie 签名密钥（可选，建议 openssl rand -hex 32）
# BRIDGE_SESSION_SECRET=
# 反向代理 HTTPS 时可设 true，使 Cookie 仅 Secure
# BRIDGE_COOKIE_SECURE=false

# 浏览器跨域调用桥接（Chatwoot 与桥接不同端口/域名时）。逗号分隔白名单；不设则对请求回显 Origin
# BRIDGE_CORS_ORIGINS=https://你的Chatwoot域名

# 按收件箱给会话打标签（便于列表区分店铺/渠道）。标签标题须先在 Chatwoot「设置 → 标签」中创建且名称一致
# JSON：inbox_id(数字) → 标签显示名。默认仅在 conversation_created 时合并写入（不覆盖其它标签）
# BRIDGE_INBOX_CHANNEL_LABELS_JSON={"2":"店-A","3":"店-B"}
# BRIDGE_INBOX_LABEL_EVENTS=conversation_created

# 按邮箱查单：优先用订单列表 keyword+email；设为 false 则只用游标扫描 + 单号补全详情
# SHOPLAZZA_EMAIL_KEYWORD_SEARCH=true
# 多店按邮箱阶段 A：全店并行 keyword 时每批并行店铺数（默认 12，范围约 4～16）
# SHOPLAZZA_KEYWORD_ALL_STORES_CONCURRENCY=12
# 索引入库时间窗口（天）：默认 730；过小会删掉老订单索引行，导致老邮件会话查不到单
# SHOPLAZZA_INDEX_BOOTSTRAP_DAYS=730
# 扩大天数后建议调用一次 POST /admin/order-index/clear-sync-cursors（Bearer）再等多轮索引同步
# 索引入库时列表无邮箱则 GET 单号详情补全（false 可减 API 调用，但 customer_email 易为空）
# SHOPLAZZA_INDEX_ENRICH_EMAIL=true
# 同一订单补全邮箱时最多尝试几种单号（完整 id / 短号等），默认 6、上限 12
# SHOPLAZZA_INDEX_ENRICH_MAX_ATTEMPTS=6
