# ── 必填配置 ──

# 公网访问地址（Webhook 回调 + 邮件链接）
SUPPORT_PUBLIC_BASE_URL=https://support.yourdomain.com

# PostgreSQL 数据库连接
SUPPORT_DATABASE_URL=postgres://user:password@localhost:5432/support_portal
# Docker Postgres 初始化密码；应与 SUPPORT_DATABASE_URL 中的数据库密码一致。
# 已存在的数据卷需要同时通过 ALTER ROLE 修改密码，仅改环境变量不会生效。
SUPPORT_POSTGRES_PASSWORD=replace-with-a-strong-random-password

# 连接池大小
SUPPORT_PG_POOL_MAX=10

# Token 签名密钥（生成命令：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"）
SUPPORT_TOKEN_SECRET=change-me-to-a-random-64-char-string

# 可选：Webhook 回调密钥；未设置时使用 SUPPORT_TOKEN_SECRET 派生每店密钥。
# 更换密钥后需重新注册各店回调地址。不是店匠 Client Secret。
# SUPPORT_WEBHOOK_SECRET=

# Bootstrap Token 有效期（天）
SUPPORT_BOOTSTRAP_TOKEN_DAYS=30

# Ticket Access Token 有效期（天）
SUPPORT_TICKET_ACCESS_TOKEN_DAYS=90

# ── 邮件配置 ──

# 发件人
SUPPORT_MAIL_FROM="Support <noreply@yourdomain.com>"
SUPPORT_MAIL_REPLY_TO=noreply@yourdomain.com

# SMTP 服务器
SUPPORT_SMTP_HOST=localhost
SUPPORT_SMTP_PORT=1025
SUPPORT_SMTP_SECURE=false
SUPPORT_SMTP_USER=
SUPPORT_SMTP_PASS=

# 物流保障独立顾客入口与通知；默认不发送，不自动复用工单发件人。
SUPPORT_PROTECTION_PUBLIC_BASE_URL=https://us-seel.com
SUPPORT_PROTECTION_MAIL_MODE=disabled
# dedicated 使用以下独立配置；shared 仅在明确允许临时共用工单邮箱后启用。
# SUPPORT_PROTECTION_SMTP_HOST=
# SUPPORT_PROTECTION_SMTP_PORT=465
# SUPPORT_PROTECTION_SMTP_SECURE=true
# SUPPORT_PROTECTION_SMTP_USER=
# SUPPORT_PROTECTION_SMTP_PASS=
# SUPPORT_PROTECTION_MAIL_FROM="Shipping Protection <support@us-seel.com>"
# SUPPORT_PROTECTION_MAIL_REPLY_TO=customersupport@reply.us-seel.com

# 共享客服收件箱：由阿里邮箱网页端生成的三方客户端安全密码，只填在服务器本地 .env。
# 启用后，每分钟通过加密 IMAP 拉取新邮件；SMTP 回复另由独立发信任务处理。
SUPPORT_MAILBOX_ENABLED=false
SUPPORT_MAILBOX_USER=customersupport@reply.us-seel.com
SUPPORT_MAILBOX_CLIENT_PASSWORD=
# SUPPORT_MAILBOX_PRIVATE_DIR=/absolute/private/mailbox/path

# 保障商品履约跟随订单完成；还需店铺 fulfillment_enabled=true。
# 首次启用记录生效时间，不自动修改历史完成订单。
SUPPORT_PROTECTION_FULFILLMENT_ENABLED=false
# Required before accepting requests: shipment or completion. Blank means dates require verification.
# Both modes keep Delay/Loss deadline at original order creation + 90 days.
SUPPORT_PROTECTION_POLICY_BASIS=shipment

# ── 管理员账户（运行 npm run seed-admin 时使用）──

# 不设置则自动生成随机密码并打印到控制台
# SUPPORT_ADMIN_USERNAME=admin
# SUPPORT_ADMIN_PASSWORD=
# SUPPORT_ADMIN_DISPLAY_NAME=Admin

# ── 店铺配置（JSON 数组，也可通过管理后台 UI 添加）──

SUPPORT_SHOPLAZZA_STORES_JSON=[]

# ── 可选配置 ──

# 服务端口
PORT=4001

# CORS 允许的源（逗号分隔，* 表示允许所有）
# SUPPORT_CORS_ORIGINS=*

# 邮件发送间隔（毫秒）
SUPPORT_EMAIL_WORKER_INTERVAL_MS=30000

# 同步日志保留天数
SUPPORT_SYNC_LOG_RETENTION_DAYS=30

# 生产模式（启用 cookie secure 标志）
NODE_ENV=production
