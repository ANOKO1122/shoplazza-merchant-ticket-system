# ── 必填配置 ──

# 公网访问地址（Webhook 回调 + 邮件链接）
SUPPORT_PUBLIC_BASE_URL=https://support.yourdomain.com

# PostgreSQL 数据库连接
SUPPORT_DATABASE_URL=postgres://user:password@localhost:5432/support_portal

# 连接池大小
SUPPORT_PG_POOL_MAX=10

# Token 签名密钥（生成命令：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"）
SUPPORT_TOKEN_SECRET=change-me-to-a-random-64-char-string

# Bootstrap Token 有效期（天）
SUPPORT_BOOTSTRAP_TOKEN_DAYS=30

# Ticket Access Token 有效期（天）
SUPPORT_TICKET_ACCESS_TOKEN_DAYS=90

# ── 邮件配置 ──

# 发件人
SUPPORT_MAIL_FROM="Support <noreply@yourdomain.com>"
SUPPORT_MAIL_REPLY_TO=noreply@yourdomain.com

# SMTP 服务器
SUPPORT_SMTP_HOST=localhost
SUPPORT_SMTP_PORT=1025
SUPPORT_SMTP_SECURE=false
SUPPORT_SMTP_USER=
SUPPORT_SMTP_PASS=

# ── 管理员账户（运行 npm run seed-admin 时使用）──

# 不设置则自动生成随机密码并打印到控制台
# SUPPORT_ADMIN_USERNAME=admin
# SUPPORT_ADMIN_PASSWORD=
# SUPPORT_ADMIN_DISPLAY_NAME=Admin

# ── 店铺配置（JSON 数组，也可通过管理后台 UI 添加）──

SUPPORT_SHOPLAZZA_STORES_JSON=[]

# ── 可选配置 ──

# 服务端口
PORT=4001

# CORS 允许的源（逗号分隔，* 表示允许所有）
# SUPPORT_CORS_ORIGINS=*

# 邮件发送间隔（毫秒）
SUPPORT_EMAIL_WORKER_INTERVAL_MS=30000

# 同步日志保留天数
SUPPORT_SYNC_LOG_RETENTION_DAYS=30

# 生产模式（启用 cookie secure 标志）
NODE_ENV=production
