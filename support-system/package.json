{
  "name": "support-bridge",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test": "tsx --test src/*.test.ts && node scripts/test-frontend-security.js && npm run test:frontend",
    "build": "tsc && npm run build:frontend",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "build:frontend": "tsc -p frontend/tsconfig.json && node scripts/build-protection.mjs",
    "test:frontend": "tsx --tsconfig frontend/tsconfig.json --test frontend/protection/*.test.tsx frontend/customer-protection/*.test.tsx frontend/mailbox/*.test.tsx"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^4.22.3",
    "express-rate-limit": "^8.5.2",
    "html-to-text": "^10.0.1",
    "imapflow": "^2.11.0",
    "multer": "^2.3.0",
    "node-fetch": "^2.7.0",
    "nodemailer": "^10.2.1",
    "pg": "^8.13.0",
    "postal-mime": "^4.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/html-to-text": "^9.0.4",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.10.0",
    "@types/node-fetch": "^2.6.11",
    "@types/pg": "^8.11.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.21.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
