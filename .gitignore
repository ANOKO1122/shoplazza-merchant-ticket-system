# 环境变量（含密码/Token/密钥）
.env
.env.*
!.env.example

# SSL证书
support-system/nginx/ssl/
support-system/postgres-ssl/

# 用户上传文件（图片附件等，含敏感信息）
support-system/uploads/
# 邮件商品缩略图缓存（运行时下载生成）
support-system/thumbnails/

# 依赖与构建产物
node_modules/
dist/
*.log
*.out.log
*.err.log

# 测试覆盖率
coverage/
.impeccable/

# Docker覆写
docker-compose.override.yml

# 系统文件
.DS_Store
Thumbs.db
support-system/protection-data/
support-system/public/protection/
support-system/public/assets/customer-protection.js
support-system/public/assets/customer-protection.css

# Claude Code / Cursor
.claude/
.cursor/

# IDE
.idea/
.vscode/
*.swp
*.swo
# Certbot runtime state and ACME challenge files
support-system/nginx/letsencrypt/
support-system/nginx/acme-challenge/*
!support-system/nginx/acme-challenge/.gitkeep

# Local reports and temporary operational artifacts
support-system/tmp/

